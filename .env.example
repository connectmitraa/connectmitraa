# ==============================================================================
# StudyLoop Backend Environment Configuration (.env.example)
# Rename this file to .env in backend or root. NEVER commit secrets to git!
# ==============================================================================

# 1. Server Configuration
PORT=8080

# 2. Database Connection
# By default, backend runs with H2 in-memory DB when these are not set.
# For Production (Supabase Postgres or Neon):
DATABASE_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Hibernate DDL: 'update' (safe for dev/staging), 'validate' or 'none' (recommended for production)
JPA_DDL_AUTO=update

# Disable H2 web console in production for security
H2_CONSOLE_ENABLED=false

# 3. Redis Configuration (Upstash Redis Free-tier for Presence & WebRTC status)
REDIS_HOST=xxxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password_here
REDIS_SSL=true

# 4. Supabase JWT Authentication Secrets
# Can be retrieved under Project Settings -> API in your Supabase Dashboard
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_signing_key_here
# CRITICAL SECURITY SETTING:
# Must be set to 'true' in staging/production to enforce cryptographic JWT signature validation!
# (Set to 'false' only in local development when using simulated/mock JWTs)
SUPABASE_JWT_VERIFY=true

# 5. CORS Allowed Origins (Comma-separated client URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://*.studyloop.app,https://*.vercel.app
